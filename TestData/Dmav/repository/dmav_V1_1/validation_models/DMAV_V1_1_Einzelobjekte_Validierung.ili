    VIEW TOPIC Einzelobjekte_Validierung = 
    DEPENDS ON DMAV_Einzelobjekte_V1_1.Einzelobjekte;
  
        VIEW v_Einzelobjekt
            PROJECTION OF DMAV_Einzelobjekte_V1_1.Einzelobjekte.Einzelobjekt;
        =
            ALL OF Einzelobjekt;

            !!@ name = CH051151
            !!@ message="(CH051151) Bei Art=Rinnsal muss die Geometrie in Linienelement sein";
            !!@ message_de="(CH051151) Bei Art=Rinnsal muss die Geometrie in Linienelement sein";
            !!@ message_fr="(CH051151) Pour les objets du Genre=ru, il faut définir la géométrie dans la table Element_lineaire";
            !!@ message_it="(CH051151) Per il genere=ruscello la geometria deve essere del tipo elemento lineare";
            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH051151: (
                (Einzelobjektart == #Rinnsal) => ((objectCount(Flaechenelement) == 0) AND (objectCount(Linienelement) > 0) AND (objectCount(Punktelement) == 0))
            );
    
