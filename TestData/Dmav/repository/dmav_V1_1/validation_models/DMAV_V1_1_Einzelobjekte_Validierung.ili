            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH052162: (
                (Einzelobjektart == #Uferverbauung) => ((objectCount(Flaechenelement) > 0) AND (objectCount(Linienelement) == 0) AND (objectCount(Punktelement) == 0))
            );

            !!@ name = CH052163
            !!@ message="(CH052163) Bei Art=Schwelle darf die Geometrie nicht in Punktelement sein";
            !!@ message_de="(CH052163) Bei Art=Schwelle darf die Geometrie nicht in Punktelement sein";
            !!@ message_fr="(CH052163) Pour les objets du Genre=seuil, la géométrie ne peut pas être définie dans la table Element_ponctuel";
            !!@ message_it="(CH052163) Per il genere=arginatura la geometria non deve essere del tipo puntiforme";
            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH052163: (
                (Einzelobjektart == #Schwelle) => (objectCount(Punktelement) == 0)
            );

            !!@ name = CH052164
            !!@ message="(CH052164) Bei Art=Lawinenverbauung muss die Geometrie in Linienelement sein";
            !!@ message_de="(CH052164) Bei Art=Lawinenverbauung muss die Geometrie in Linienelement sein";
            !!@ message_fr="(CH052164) Pour les objets du Genre=paravalanche, il faut définir la géométrie dans la table Element_lineaire";
            !!@ message_it="(CH052164) Per il genere=riparo_antivalanghe la geometria deve essere del tipo elemento lineare";
            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH052164: (
                (Einzelobjektart == #Lawinenverbauung) => ((objectCount(Flaechenelement) == 0) AND (objectCount(Linienelement) > 0) AND (objectCount(Punktelement) == 0))
            );

            !!@ name = CH052165
            !!@ message="(CH052165) Bei Art=massiver_Sockel darf die Geometrie nicht in Punktelement sein";
            !!@ message_de="(CH052165) Bei Art=massiver_Sockel darf die Geometrie nicht in Punktelement sein";
            !!@ message_fr="(CH052165) Pour les objets du Genre=socle_massif, la géométrie ne peut pas être définie dans la table Element_ponctuel";
            !!@ message_it="(CH052165) Per il genere=zoccolo_massiccio la geometria non deve essere del tipo puntiforme";
            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH052165: (
                (Einzelobjektart == #massiver_Sockel) => (objectCount(Punktelement) == 0)
            );

            !!@ name = CH052166
            !!@ message="(CH052166) Bei Art=Ruine_archaeologisches_Objekt darf die Geometrie nicht in Punktelement sein";
            !!@ message_de="(CH052166) Bei Art=Ruine_archaeologisches_Objekt darf die Geometrie nicht in Punktelement sein";
            !!@ message_fr="(CH052166) Pour les objets du Genre=ruine_objet_archeologique, la géométrie ne peut pas être définie dans la table Element_ponctuel";
            !!@ message_it="(CH052166) Per il genere=rovina_oggetto_archeologico la geometria non deve essere del tipo puntiforme";
            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH052166: (
                (Einzelobjektart == #Ruine_archaeologisches_Objekt) => (objectCount(Punktelement) == 0)
            );

            !!@ name = CH052171
            !!@ message="(CH052171) Bei Art=Hochspannungsfreileitung darf die Geometrie nicht in Punktelement sein";
            !!@ message_de="(CH052171) Bei Art=Hochspannungsfreileitung darf die Geometrie nicht in Punktelement sein";
            !!@ message_fr="(CH052171) Pour les objets du Genre=ligne_aerienne_a_haute_tension, la géométrie ne peut pas être définie dans la table Element_ponctuel";
            !!@ message_it="(CH052171) Per il genere=linea_aerea_ad_alta_tensione la geometria non deve essere del tipo puntiforme";
            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH052171: (
                (Einzelobjektart == #Hochspannungsfreileitung) => (objectCount(Punktelement) == 0)
            );

            !!@ name = CH052177
            !!@ message="(CH052177) Bei Art=Mauer darf die Geometrie nicht in Punktelement sein";
            !!@ message_de="(CH052177) Bei Art=Mauer darf die Geometrie nicht in Punktelement sein";
            !!@ message_fr="(CH052177) Pour les objets du Genre=mur, la géométrie ne peut pas être définie dans la table Element_ponctuel";
            !!@ message_it="(CH052177) Per il genere=muro la geometria non deve essere del tipo puntiforme";
            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH052177: (
                (Einzelobjektart == #Mauer) => (objectCount(Punktelement) == 0)
            );

            !!@ name = CH052178
            !!@ message="(CH052178) Bei Art=uebriger_Gebaeudeteil darf die Geometrie nicht in Punktelement sein";
            !!@ message_de="(CH052178) Bei Art=uebriger_Gebaeudeteil darf die Geometrie nicht in Punktelement sein";
            !!@ message_fr="(CH052178) Pour les objets du Genre=autre_corps_de_batiment, la géométrie ne peut pas être définie dans la table Element_ponctuel";
            !!@ message_it="(CH052178) Per il genere=altra_parte_di_edificio la geometria non deve essere del tipo puntiforme";
            !! AGI SH: Failcase umgesetzt;
            MANDATORY CONSTRAINT CH052178: (
                (Einzelobjektart == #uebriger_Gebaeudeteil) => (objectCount(Punktelement) == 0)
            );

            !!@ name = GWRC02c
            !!@ message="(GWRC02c) EGID existiert nicht im GWR";
            !!@ message_de="(GWRC02c) EGID existiert nicht im GWR";
            !!@ message_fr="(GWRC02c) L'EGID n'existe pas dans le RegBL";
            !!@ message_it="(GWRC02c) L'EGID non esiste nel REA";
            !! Umsetzung Phase 3;
            /*
            MANDATORY CONSTRAINT GWRC02c: (
                DEFINED(EGID) => DMAV_GWR("C02")
            );
            */

        END v_Einzelobjekt;

        VIEW v_Messpunkt
            PROJECTION OF DMAV_Einzelobjekte_V1_1.Einzelobjekte.Messpunkt;
        =
            ALL OF Messpunkt;

            !!@ name = CH054351
            !!@ message="(CH054351) Messpunkt darf kein Grenzpunkt, LFP1, LFP2 oder LFP3 sein";
            !!@ message_de="(CH054351) Messpunkt darf kein Grenzpunkt, LFP1, LFP2 oder LFP3 sein";
            !!@ message_fr="(CH054351) Le PointMesure ne doit pas être un point_limite, PFP1, PFP2 ou PFP3";
            !!@ message_it="(CH054351) Il punto di misura non deve essere un punto limite, PFP1, PFP2 o PFP3.";
            !! Kategorie: modellübergreifend
            !! Umsetzung Phase 2;
            MANDATORY CONSTRAINT CH054351: (
                NOT(DMAVTYM_Topologie_V1_0.pointInPoints(THIS, >>Geometrie, ObjectPool_V1_0.allObjects(>DMAV_FixpunkteAVKategorie3_V1_1.FixpunkteAVKategorie3.LFP3), >>DMAV_FixpunkteAVKategorie3_V1_1.FixpunkteAVKategorie3.LFP3->Geometrie))
                AND NOT(DMAVTYM_Topologie_V1_0.pointInPoints(THIS, >>Geometrie, ObjectPool_V1_0.allObjects(>DMAV_Grundstuecke_V1_1.Grundstuecke.Grenzpunkt), >>DMAV_Grundstuecke_V1_1.Grundstuecke.Grenzpunkt->Geometrie))
                AND NOT(DMAVTYM_Topologie_V1_0.pointInPoints(THIS, >>Geometrie, ObjectPool_V1_0.allObjects(>FixpunkteLV_V1_0.FixpunkteLV.LFP1), >>FixpunkteLV_V1_0.FixpunkteLV.LFP1->Geometrie))
                AND NOT(DMAVTYM_Topologie_V1_0.pointInPoints(THIS, >>Geometrie, ObjectPool_V1_0.filter(ObjectPool_V1_0.allObjects(>KGKCGC_FPDS2_V1_1.FPDS2.FixpunktVersion),"NOT(DEFINED(UntergegangenAm))"), >>KGKCGC_FPDS2_V1_1.FPDS2.FixpunktVersion->Geometrie))
            );

        END v_Messpunkt;

    END Einzelobjekte_Validierung;

END DMAV_V1_1_Einzelobjekte_Validierung.
