GITHUB_ACTOR=<your github username>
GITHUB_TOKEN=<your github PAT with packages:read permission>

# Only needed when running the optional ZITADEL override (docker-compose.zitadel.yml).
# Both ids come from the one-time console setup, see "ZITADEL lokal" in README.md.
ZITADEL_CLIENT_ID=<client id of the user agent application>
ZITADEL_API_ID=<client id of the api application>
